# ─── Database ──────────────────────────────────────────────────────────────
# Local dev: file:./dev.db
# Production: overridden by docker-compose.yml to file:./data/youvsyou.db
DATABASE_URL="file:./dev.db"

# ─── Session (iron-session) ────────────────────────────────────────────────
# Must be ≥32 random chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD="CHANGE_ME_random_32_char_secret_min"

# ─── Admin / player credentials ────────────────────────────────────────────
# Used once by the seed script to create the user. After first start, change
# the password in the DB rather than here (or wipe data/ and re-seed).
ADMIN_USERNAME="Sartaj"
ADMIN_PASSWORD="CHANGE_ME_strong_password"
